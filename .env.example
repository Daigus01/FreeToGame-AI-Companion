# Copy to .env (never commit). Backend secrets stay in the backend (RNF-4).
DATABASE_URL=postgresql+asyncpg://ftg:ftg@localhost:5432/ftg
REDIS_URL=redis://localhost:6379/0
FREETOGAME_BASE_URL=https://www.freetogame.com/api
FREETOGAME_CACHE_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=openai            # openai | anthropic (anthropic not implemented: P2-07)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Auth (D-11): OAuth with Google + Discord. See docs/OAUTH_SETUP.md
SESSION_SECRET=change-me-generate-a-random-string
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
ALLOW_DEV_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ENABLE_SCHEDULER=true
RECS_CRON_HOUR=0
RECS_CRON_MINUTE=0
# Frontend (public values only)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional local-dev fallback, only if the backend runs with ALLOW_DEV_AUTH=true. Leave empty when using OAuth.
NEXT_PUBLIC_DEV_USER_ID=
