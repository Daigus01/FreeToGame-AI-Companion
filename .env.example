# Copy to .env (never commit). Backend secrets stay in the backend (RNF-4).
DATABASE_URL=postgresql+asyncpg://ftg:ftg@localhost:5432/ftg
REDIS_URL=redis://localhost:6379/0
FREETOGAME_BASE_URL=https://www.freetogame.com/api
FREETOGAME_CACHE_TTL_SECONDS=43200
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=openai            # openai | anthropic (anthropic not implemented: P2-07)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ENABLE_SCHEDULER=true
RECS_CRON_HOUR=0
RECS_CRON_MINUTE=0
# Frontend (public values only)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001
